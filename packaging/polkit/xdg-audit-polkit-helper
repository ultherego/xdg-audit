#!/usr/bin/python3 -I
"""Installed, root-owned Polkit helper: ONLY an isolated test directory.

This binary must be installed as /usr/libexec/xdg-audit/xdg-audit-polkit-helper,
owned by root, not executed from a user's editable source checkout.

The helper accepts no paths from callers. PKEXEC_UID selects an isolated
test namespace; no XDG/quarantine files can ever be accessed or removed.
"""
from __future__ import annotations

import json
import os
from pathlib import Path
import pwd
import re
import stat
import sys

TEST_BASE = Path("/var/lib/xdg-audit/polkit-selftest")
TEST_NAME = "authorization-demo"
MARKER = "test-only.txt"
MARKER_DATA = b"xdg-audit polkit isolated self-test v1\n"
FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)


class Rejected(RuntimeError):
    pass


def _check_dir(fd: int, owner: int) -> None:
    st = os.fstat(fd)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != owner or (st.st_mode & 0o022):
        raise Rejected("Unsafe owner or write permissions in privileged test tree")


def _open_base(base: Path, owner: int, *, create: bool) -> int:
    """Traverse all components without symlinks; create only under /var/lib."""
    if not base.is_absolute() or ".." in base.parts:
        raise Rejected("Invalid test base")
    fd = os.open("/", FLAGS)
    try:
        _check_dir(fd, owner)
        for i, part in enumerate(base.parts[1:]):
            # Only the two product-owned directories may be created.
            allow_create = create and i >= len(base.parts[1:]) - 2
            if allow_create:
                try:
                    os.mkdir(part, 0o700, dir_fd=fd)
                except FileExistsError:
                    pass
            new = os.open(part, FLAGS, dir_fd=fd)
            os.close(fd)
            fd = new
            _check_dir(fd, owner)
        return fd
    except BaseException:
        os.close(fd)
        raise


def _user_directory(basefd: int, uid: int, owner: int, *, create: bool) -> int:
    name = str(uid)
    if not (0 < uid < 2**31):
        raise Rejected("Invalid calling user UID")
    if create:
        try:
            os.mkdir(name, 0o700, dir_fd=basefd)
        except FileExistsError:
            pass
    fd = os.open(name, FLAGS, dir_fd=basefd)
    _check_dir(fd, owner)
    return fd


def _open_demo(userfd: int, owner: int) -> int:
    demo = os.open(TEST_NAME, FLAGS, dir_fd=userfd)
    _check_dir(demo, owner)
    return demo


def _verify_demo(userfd: int, owner: int) -> int:
    demo = _open_demo(userfd, owner)
    try:
        if set(os.listdir(demo)) != {MARKER}:
            raise Rejected("Test directory contains unexpected data; refusing deletion")
        st = os.stat(MARKER, dir_fd=demo, follow_symlinks=False)
        if (not stat.S_ISREG(st.st_mode) or st.st_uid != owner or
                st.st_nlink != 1 or st.st_size != len(MARKER_DATA)):
            raise Rejected("Test marker is not the expected root-owned file")
        filefd = os.open(MARKER, os.O_RDONLY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0),
                         dir_fd=demo)
        try:
            opened = os.fstat(filefd)
            if (opened.st_dev, opened.st_ino) != (st.st_dev, st.st_ino):
                raise Rejected("Test marker changed while opening")
            if os.read(filefd, len(MARKER_DATA) + 1) != MARKER_DATA:
                raise Rejected("Test marker content changed")
        finally:
            os.close(filefd)
        return demo
    except BaseException:
        os.close(demo)
        raise


def test_create(base: Path, uid: int, owner: int = 0) -> dict:
    """Create the exact root-owned fixture, never overwrite an existing one."""
    basefd = _open_base(base, owner, create=True)
    try:
        userfd = _user_directory(basefd, uid, owner, create=True)
        try:
            try:
                os.mkdir(TEST_NAME, 0o700, dir_fd=userfd)
            except FileExistsError:
                fd = _verify_demo(userfd, owner)
                os.close(fd)
                return {"status": "already_exists", "fixture": str(base / str(uid) / TEST_NAME),
                        "uid": uid, "deleted": False}
            demo = _open_demo(userfd, owner)
            try:
                f = os.open(MARKER, os.O_WRONLY | os.O_CREAT | os.O_EXCL |
                            os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0),
                            0o600, dir_fd=demo)
                try:
                    os.write(f, MARKER_DATA)
                    os.fsync(f)
                finally:
                    os.close(f)
                os.fsync(demo)
            finally:
                os.close(demo)
            os.fsync(userfd)
            return {"status": "created", "fixture": str(base / str(uid) / TEST_NAME),
                    "uid": uid, "deleted": False}
        finally:
            os.close(userfd)
    finally:
        os.close(basefd)


def test_delete(base: Path, uid: int, owner: int = 0) -> dict:
    """Unlink only the exact verified marker and its empty demo directory."""
    basefd = _open_base(base, owner, create=False)
    try:
        userfd = _user_directory(basefd, uid, owner, create=False)
        try:
            demo = _verify_demo(userfd, owner)
            try:
                # Recheck after inspection and refuse any newly added entries.
                if set(os.listdir(demo)) != {MARKER}:
                    raise Rejected("Demo changed during verification")
                os.unlink(MARKER, dir_fd=demo)
                os.fsync(demo)
            finally:
                os.close(demo)
            os.rmdir(TEST_NAME, dir_fd=userfd)
            os.fsync(userfd)
            return {"status": "deleted", "fixture": str(base / str(uid) / TEST_NAME),
                    "uid": uid, "deleted": True}
        finally:
            os.close(userfd)
    finally:
        os.close(basefd)


def _authenticated_uid() -> int:
    """Use trusted pkexec metadata, never an UID supplied as an argument."""
    if os.getuid() != 0 or os.geteuid() != 0:
        raise Rejected("Polkit helper must run as root")
    raw = os.environ.get("PKEXEC_UID")
    if not raw or not re.fullmatch(r"[0-9]{1,10}", raw):
        raise Rejected("Missing authenticated pkexec caller")
    uid = int(raw)
    if uid == 0:
        raise Rejected("Test must be invoked by a non-root user")
    pwd.getpwuid(uid)
    return uid


def main(argv: list[str]) -> int:
    if len(argv) != 1 or argv[0] not in ("test-create", "test-delete"):
        raise Rejected("Only test-create and test-delete are supported")
    uid = _authenticated_uid()
    if argv[0] == "test-create":
        result = test_create(TEST_BASE, uid)
    else:
        result = test_delete(TEST_BASE, uid)
    print(json.dumps(result, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (Rejected, OSError, ValueError, KeyError) as exc:
        print("xdg-audit polkit helper: " + str(exc), file=sys.stderr)
        sys.exit(1)
